serve {
  collector http_port="9999"
  api auth="winnow-sample-auth"
}

auth name="winnow-sample-auth" {
  login_url "http://localhost:3005/login?return_to={winnow_return_url}"
  logout_url "http://localhost:3005/logout"

  strategy "cookie"
  cookie_name "jwt"

  config kind="module" {
    module "winnow-sample-module"
  }
}

module name="winnow-sample-module" {
  dll "backend/sample_module/zig-out/lib/libwinnow-sample-module.so"
  config {
    jwks_issuer_url "http://localhost:7292"
  }
}

traces index="winnow-traces-v0_2" retention="90 days"
logs index="winnow-logs-v0_2" retention="30 days"
